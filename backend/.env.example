# Copy this file to .env and fill in real values. Never commit .env.

# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Number of cluster worker processes (keep 1 on free hosting)
WEB_CONCURRENCY=1
# Proxy hops in front of the app so rate limiting sees real client IPs (Render: 1). Leave empty locally.
TRUST_PROXY=
# Frontend origin allowed by CORS / Socket.IO, also used in password-reset links
FRONTEND_URL=http://localhost:5173

# ---------- Database (MongoDB Atlas) ----------
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campuscode?retryWrites=true&w=majority

# ---------- Auth ----------
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# ---------- Judge0 (code execution) ----------
# Self-hosted: http://localhost:2358   RapidAPI: https://judge0-ce.p.rapidapi.com
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# Only for RapidAPI; leave empty for self-hosted Judge0
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# ---------- Redis (code-draft autosave + Socket.IO adapter) ----------
# Option A: one URL (Upstash). "rediss://" = TLS.
REDIS_URL=
# Option B: separate fields (local Redis / Docker). Ignored when REDIS_URL is set.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CONNECT_TIMEOUT=10000
REDIS_KEEP_ALIVE=30000
REDIS_MAX_RETRIES=10
REDIS_KEY_PREFIX=campuscode:draft

# ---------- Code draft autosave ----------
DRAFT_TTL_BUFFER_HOURS=1
MAX_CODE_SIZE_BYTES=204800

# ---------- Email (credentials + password reset) ----------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
# For Gmail use an App Password, not your normal password
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=CampusCode
EMAIL_BATCH_SIZE=50
EMAIL_BATCH_DELAY=1000

# ---------- Logging ----------
LOG_LEVEL=info
LOG_DIR=./logs

# ---------- Scripts only ----------
# scripts/createSuperadmin.js (password is required, there is no default)
SUPERADMIN_NAME=Super Administrator
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=
# scripts/hashPassword.js
PASSWORD_TO_HASH=
