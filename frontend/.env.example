# Copy this file to .env and fill in real values. Vite only exposes vars that start with VITE_.
# These end up in the browser bundle, so never put secrets here.

# Backend URL (no trailing slash). Used for REST calls and the Socket.IO connection.
VITE_API_BASE_URL=http://localhost:5000
# Axios request timeout in ms
VITE_API_TIMEOUT=100000
# How often the exam editor autosaves a draft, in ms
VITE_AUTOSAVE_INTERVAL_MS=30000
